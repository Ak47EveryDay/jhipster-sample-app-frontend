{
  "name": "jhipster-sample-app-frontend",
  "version": "0.0.1-SNAPSHOT",
  "private": true,
  "description": "Angular frontend of the JHipster sample application",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "ng build",
    "build:dev": "ng build --configuration development",
    "ci:server:await": "echo \"Waiting for server at port $npm_package_config_backend_port to start\" && wait-on -t 180000 http-get://127.0.0.1:$npm_package_config_backend_port/management/health && echo \"Server at port $npm_package_config_backend_port started\"",
    "cypress": "cypress open --e2e",
    "cypress:audits": "cypress open --e2e --config-file cypress-audits.config.ts",
    "e2e": "cypress run --e2e --browser chrome",
    "e2e:audits": "npm run e2e -- --config-file cypress-audits.config.ts",
    "e2e:headless": "npm run ci:server:await && npm run e2e",
    "lint": "eslint .",
    "lint:fix": "npm run lint -- --fix",
    "prepare": "husky",
    "prettier:check": "prettier --check \"{,build-plugins/**/,src/**/,cypress/**/}*.{md,json,yml,js,cjs,mjs,ts,cts,mts,html,css,scss}\"",
    "prettier:format": "prettier --write \"{,build-plugins/**/,src/**/,cypress/**/}*.{md,json,yml,js,cjs,mjs,ts,cts,mts,html,css,scss}\"",
    "serve": "npm run start --",
    "start": "ng serve --hmr",
    "pretest": "npm run lint",
    "test": "ng test --coverage",
    "test:watch": "npm run test -- --watch",
    "watch": "ng build --watch --configuration development"
  },
  "config": {
    "backend_port": 8080
  },
  "dependencies": {
    "@angular/common": "22.1.6",
    "@angular/compiler": "22.1.6",
    "@angular/core": "22.1.6",
    "@angular/forms": "22.1.6",
    "@angular/localize": "22.1.6",
    "@angular/platform-browser": "22.1.6",
    "@angular/router": "22.1.6",
    "@fortawesome/angular-fontawesome": "5.1.0",
    "@fortawesome/free-solid-svg-icons": "7.3.1",
    "@ng-bootstrap/ng-bootstrap": "21.0.0",
    "@ngx-translate/core": "18.0.0",
    "bootstrap": "5.3.8",
    "dayjs": "1.11.23",
    "ngx-infinite-scroll": "22.0.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular-builders/custom-esbuild": "22.0.1",
    "@angular/build": "22.1.8",
    "@angular/cli": "22.1.8",
    "@angular/compiler-cli": "22.1.6",
    "@angular/service-worker": "22.1.6",
    "@cypress/schematic": "6.0.0",
    "@eslint/js": "10.0.1",
    "@types/folder-hash": "4.0.4",
    "@types/node": "22.20.2",
    "@vitest/coverage-v8": "4.1.11",
    "angular-eslint": "22.5.0",
    "axios": "1.20.0",
    "cypress": "16.0.0",
    "cypress-audit": "1.1.0",
    "cypress-terminal-report": "7.3.3",
    "deepmerge": "4.3.1",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-cypress": "7.0.2",
    "eslint-plugin-prettier": "5.5.6",
    "folder-hash": "4.1.3",
    "globals": "17.12.0",
    "husky": "9.1.7",
    "jiti": "2.7.0",
    "jsdom": "30.0.1",
    "lighthouse": "13.4.1",
    "lint-staged": "17.5.1",
    "prettier": "3.9.6",
    "prettier-plugin-packagejson": "3.0.2",
    "swagger-ui-dist": "5.32.15",
    "tinyglobby": "0.2.17",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "4.1.11",
    "vitest-sonar-reporter": "3.0.0",
    "wait-on": "9.1.0"
  },
  "engines": {
    "node": ">=24.21.0"
  },
  "allowScripts": {
    "cypress": true
  }
}
